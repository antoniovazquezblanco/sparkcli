# Shared VHS styling for every SparkCLI demo.
# Edit it once here to restyle every screenshot and GIF at the same time.
# Reference: https://github.com/charmbracelet/vhs#settings

Set Shell bash
#Set FontSize 14
#Set Width 1000
#Set Padding 10
#Set Margin 10
#Set MarginFill "#1e1e2e"
#Set WindowBar Colorful
#Set Theme "Catppuccin Mocha"
#Set TypingSpeed 60ms

Hide
Type `export PS1="\$ "` Enter
Type "clear" Enter
Sleep 500ms
Show